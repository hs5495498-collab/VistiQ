# Bearer token this worker requires on every POST /tryon request.
#
# Generate a fresh random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set the SAME value as VISTIQ_TRYON_WORKER_TOKEN in vistiq-backend/.env.
# Never commit the real value, and never reuse a token that has ever been
# displayed in a terminal, log, chat transcript, or screenshot.
CATVTON_WORKER_TOKEN=
