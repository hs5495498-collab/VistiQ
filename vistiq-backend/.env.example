# Phase 4 authentication cookie configuration.
#
# Controls the Secure attribute on the session/CSRF cookies
# (app/security/sessions.py). MUST stay "false" for local HTTP development
# (http://127.0.0.1:8000) — a Secure cookie is silently dropped by every
# browser over plain HTTP, which would break login entirely. Set to
# "true" only when VISTIQ is actually served over HTTPS.
VISTIQ_COOKIE_SECURE=false

# Phase 5 (experimental) — virtual try-on GPU worker.
#
# Base URL of a separately-running GPU inference worker that actually runs
# CatVTON (see docs/virtual-tryon.md for the worker's expected HTTP
# contract and why this backend can't run it directly). Left empty/unset
# by default: with no worker configured, POST /tryon still creates a job
# record so the rest of the feature is testable, but immediately marks it
# "failed" with a clear "unavailable" message instead of hanging forever.
# This project does NOT ship a live worker — a Colab notebook is not a
# permanent deployment target; point this at a real, secured worker URL
# only when one actually exists.
VISTIQ_TRYON_WORKER_URL=

# Optional: seconds to wait for the worker before giving up (default 120).
VISTIQ_TRYON_WORKER_TIMEOUT_S=120
